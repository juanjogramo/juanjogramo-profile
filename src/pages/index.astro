---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Expertise from '@/components/Expertise.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import Projects from '@/components/Projects.astro';
import Writing from '@/components/Writing.astro';
import Education from '@/components/Education.astro';
import Contact from '@/components/Contact.astro';
import { getProfile } from '@/content';
import { getUi } from '@/content/i18n/ui';

const locale = 'en';
const profile = getProfile(locale);
const ui = getUi(locale);
---

<BaseLayout locale={locale} profile={profile} ui={ui}>
  <Hero profile={profile} ui={ui} />
  <About profile={profile} ui={ui} />
  <Experience profile={profile} ui={ui} />
  <Expertise profile={profile} ui={ui} />
  <FeaturedWork profile={profile} ui={ui} />
  <Projects profile={profile} ui={ui} />
  <Writing profile={profile} ui={ui} />
  <Education profile={profile} ui={ui} />
  <Contact profile={profile} ui={ui} />
</BaseLayout>

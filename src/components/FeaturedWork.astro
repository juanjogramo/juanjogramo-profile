---
import type { Profile } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';

interface Props {
  profile: Profile;
  ui: UiCopy;
}

const { profile, ui } = Astro.props;
if (!profile.features.caseStudies || profile.caseStudies.length === 0) return;
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <p class="prompt">cat {ui.work.eyebrow.toLowerCase().replace(/\s+/g, '_')}.log</p>
    <h2 id="work-title" class="section-title">{ui.work.title}</h2>
    <p class="note">{ui.work.confidentialNote}</p>

    <div class="cases">
      {
        profile.caseStudies.map((study) => (
          <article class="case">
            <h3>{study.title}</h3>
            <dl>
              <div>
                <dt>{ui.work.context}</dt>
                <dd>{study.context}</dd>
              </div>
              <div>
                <dt>{ui.work.problem}</dt>
                <dd>{study.problem}</dd>
              </div>
              <div>
                <dt>{ui.work.role}</dt>
                <dd>{study.role}</dd>
              </div>
              <div>
                <dt>{ui.work.approach}</dt>
                <dd>{study.approach}</dd>
              </div>
              <div>
                <dt>{ui.work.outcome}</dt>
                <dd>{study.outcome}</dd>
              </div>
            </dl>
            {study.technologies.length > 0 && (
              <>
                <p class="tech-label"># {ui.work.technologies.toLowerCase()}</p>
                <ul class="tag-list">
                  {study.technologies.map((tech) => (
                    <li class="tag">{tech}</li>
                  ))}
                </ul>
              </>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .note {
    margin: calc(var(--space-5) * -0.5) auto var(--space-5);
    max-width: 52ch;
    color: var(--color-ink-subtle);
    font-size: var(--text-sm);
    text-align: center;
  }

  .cases {
    display: grid;
    gap: var(--space-5);
  }

  .case {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    text-align: center;
  }

  .case h3 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
    max-width: 24ch;
    margin-inline: auto;
  }

  dl {
    margin: 0 0 var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  dt {
    margin: 0 0 var(--space-1);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  dd {
    margin: 0 auto;
    color: var(--color-ink-muted);
    max-width: 58ch;
  }

  .tech-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-amber);
  }

  @media (min-width: 900px) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      text-align: left;
    }

    dd {
      margin-left: 0;
      margin-right: 0;
    }

    .tag-list {
      justify-content: flex-start;
    }

    .case {
      text-align: left;
    }

    .case h3 {
      margin-inline: 0;
    }
  }
</style>

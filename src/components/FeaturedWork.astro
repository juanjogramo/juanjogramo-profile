---
import type { Profile } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';

interface Props {
  profile: Profile;
  ui: UiCopy;
}

const { profile, ui } = Astro.props;
if (!profile.features.caseStudies || profile.caseStudies.length === 0) return;
---

<section id="work" class="section section--alt" aria-labelledby="work-title">
  <div class="container">
    <p class="eyebrow">{ui.work.eyebrow}</p>
    <h2 id="work-title" class="section-title">{ui.work.title}</h2>
    <p class="note">{ui.work.confidentialNote}</p>

    <div class="cases">
      {
        profile.caseStudies.map((study) => (
          <article class="case">
            <h3>{study.title}</h3>
            <dl>
              <div>
                <dt>{ui.work.context}</dt>
                <dd>{study.context}</dd>
              </div>
              <div>
                <dt>{ui.work.problem}</dt>
                <dd>{study.problem}</dd>
              </div>
              <div>
                <dt>{ui.work.role}</dt>
                <dd>{study.role}</dd>
              </div>
              <div>
                <dt>{ui.work.approach}</dt>
                <dd>{study.approach}</dd>
              </div>
              <div>
                <dt>{ui.work.outcome}</dt>
                <dd>{study.outcome}</dd>
              </div>
            </dl>
            {study.technologies.length > 0 && (
              <>
                <p class="tech-label">{ui.work.technologies}</p>
                <ul class="tag-list">
                  {study.technologies.map((tech) => (
                    <li class="tag">{tech}</li>
                  ))}
                </ul>
              </>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .note {
    margin: calc(var(--space-5) * -1) 0 var(--space-6);
    max-width: 52ch;
    color: var(--color-ink-subtle);
    font-size: var(--text-sm);
  }

  .cases {
    display: grid;
    gap: var(--space-6);
  }

  .case {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .case h3 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  dl {
    margin: 0 0 var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  dt {
    margin: 0 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  dd {
    margin: 0;
    color: var(--color-ink-muted);
    max-width: 62ch;
  }

  .tech-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }

  @media (min-width: 900px) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
</style>

---
import type { Profile } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';

interface Props {
  profile: Profile;
  ui: UiCopy;
}

const { profile, ui } = Astro.props;
---

<section id="expertise" class="section" aria-labelledby="expertise-title">
  <div class="container">
    <p class="prompt">tree {ui.expertise.eyebrow.toLowerCase()}/</p>
    <h2 id="expertise-title" class="section-title">{ui.expertise.title}</h2>

    <div class="expertise-grid">
      {
        profile.skills.map((group) => (
          <article class="expertise-group">
            <h3>./{group.id}</h3>
            <p class="group-title">{group.title}</p>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .expertise-grid {
    display: grid;
    gap: var(--space-4);
  }

  .expertise-group {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    text-align: center;
  }

  .expertise-group h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .group-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .expertise-group ul {
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    color: var(--color-ink-muted);
    max-width: 36ch;
    text-align: left;
  }

  .expertise-group li::before {
    content: '- ';
    color: var(--color-accent);
  }

  @media (min-width: 800px) {
    .expertise-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

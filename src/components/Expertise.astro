---
import type { Profile } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';

interface Props {
  profile: Profile;
  ui: UiCopy;
}

const { profile, ui } = Astro.props;
---

<section id="expertise" class="section" aria-labelledby="expertise-title">
  <div class="container">
    <p class="eyebrow">{ui.expertise.eyebrow}</p>
    <h2 id="expertise-title" class="section-title">{ui.expertise.title}</h2>

    <div class="expertise-grid">
      {
        profile.skills.map((group) => (
          <article class="expertise-group">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .expertise-grid {
    display: grid;
    gap: var(--space-5);
  }

  .expertise-group {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .expertise-group h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .expertise-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    color: var(--color-ink-muted);
  }

  .expertise-group li {
    padding-left: 0.9rem;
    position: relative;
  }

  .expertise-group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--color-accent);
  }

  @media (min-width: 800px) {
    .expertise-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-7);
    }
  }
</style>

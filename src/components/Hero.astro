---
import type { Profile } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';
import Button from './Button.astro';

interface Props {
  profile: Profile;
  ui: UiCopy;
}

const { profile, ui } = Astro.props;
const cwd = `/home/${profile.location.toLowerCase().replace(/,\s*/g, '/')}`;
const ctaPrimary = `./${ui.hero.ctaPrimary.toLowerCase().replace(/\s+/g, '-')}`;
const ctaSecondary = `./${ui.hero.ctaSecondary.toLowerCase().replace(/\s+/g, '-')}`;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="container hero__inner">
    {
      profile.features.portrait && profile.portrait && (
        <div class="hero__media" data-boot-item data-boot-mode="resolve">
          <div class="hero__portrait-frame">
            <picture>
              <source srcset="/images/portrait.webp" type="image/webp" />
              <img
                src={profile.portrait.src}
                alt={profile.portrait.alt}
                width="819"
                height="1024"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="hero__portrait"
                data-portrait
              />
            </picture>
            <canvas class="hero__portrait-canvas" aria-hidden="true"></canvas>
          </div>
        </div>
      )
    }

    <div class="hero__copy" data-terminal-boot data-pending>
      <p class="term-line term-line--cmd" data-boot-item data-boot-mode="command" data-text="whoami">
        <span class="prompt-prefix" aria-hidden="true">$</span>
        <span class="term-typed"></span>
      </p>

      <h1
        id="hero-name"
        class="hero__name term-line"
        data-boot-item
        data-boot-mode="output"
        data-text={profile.fullName}
      >
        <span class="term-typed">{profile.fullName}</span>
      </h1>

      <p
        class="term-line term-line--cmd"
        data-boot-item
        data-boot-mode="command"
        data-text="cat role.txt"
      >
        <span class="prompt-prefix" aria-hidden="true">$</span>
        <span class="term-typed"></span>
      </p>

      <p
        class="hero__title term-line"
        data-boot-item
        data-boot-mode="output"
        data-text={profile.professionalTitle}
      >
        <span class="term-typed">{profile.professionalTitle}</span>
      </p>

      <p
        class="term-line term-line--cmd"
        data-boot-item
        data-boot-mode="command"
        data-text="echo $VALUE"
      >
        <span class="prompt-prefix" aria-hidden="true">$</span>
        <span class="term-typed"></span>
      </p>

      <p
        class="hero__value term-line"
        data-boot-item
        data-boot-mode="output"
        data-text={profile.valueProposition}
      >
        <span class="term-typed">{profile.valueProposition}</span>
      </p>

      <p
        class="hero__summary term-line"
        data-boot-item
        data-boot-mode="output"
        data-text={profile.summary}
      >
        <span class="term-typed">{profile.summary}</span>
      </p>

      <div class="btn-row" data-boot-item data-boot-mode="fade">
        <Button href="#experience" variant="primary">{ctaPrimary}</Button>
        <Button href="#contact" variant="secondary">{ctaSecondary}</Button>
      </div>

      <ul class="social-links" data-boot-item data-boot-mode="fade">
        {
          profile.contact.email && (
            <li>
              <a href={`mailto:${profile.contact.email}`}>
                mailto:{ui.contact.email.toLowerCase()}
              </a>
            </li>
          )
        }
        {
          profile.contact.github && (
            <li>
              <a href={profile.contact.github} rel="noopener noreferrer" target="_blank">
                open github
              </a>
            </li>
          )
        }
        {
          profile.contact.linkedin && (
            <li>
              <a href={profile.contact.linkedin} rel="noopener noreferrer" target="_blank">
                open linkedin
              </a>
            </li>
          )
        }
      </ul>

      <div class="hero__cwd" data-boot-item data-boot-mode="command-block">
        <p class="term-line term-line--cmd" data-text="pwd">
          <span class="prompt-prefix" aria-hidden="true">$</span>
          <span class="term-typed"></span>
        </p>
        <p class="path term-line" data-boot-mode="output" data-text={cwd}>
          <span class="term-typed">{cwd}</span>
        </p>
      </div>

      <span class="boot-cursor" data-boot-cursor aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
    justify-items: center;
    text-align: center;
    min-width: 0;
  }

  .hero__copy {
    position: relative;
    display: grid;
    justify-items: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    gap: 0;
  }

  .hero__media {
    display: grid;
    justify-items: center;
  }

  /* Prevent flash of full text before the typewriter starts (JS only) */
  :global(html.js) .hero__copy[data-pending] > [data-boot-item] {
    visibility: hidden;
    height: 0;
    margin: 0;
    overflow: hidden;
  }

  .hero__portrait-frame {
    position: relative;
    width: min(100%, 12.5rem);
    aspect-ratio: 819 / 1024;
    overflow: hidden;
    border: 1px solid var(--color-accent);
    box-shadow: 4px 4px 0 var(--color-accent-soft);
    background: #111;
  }

  .hero__portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero__portrait-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__media[data-resolving] .hero__portrait {
    opacity: 0;
  }

  .hero__media:not([data-resolving]) .hero__portrait-canvas {
    display: none;
  }

  :global(html.js) .hero__media:not([data-boot-done]):not([data-resolving]) {
    visibility: hidden;
  }

  .term-line {
    margin: 0 auto var(--space-3);
    max-width: min(46ch, 100%);
    text-align: center;
    min-width: 0;
  }

  .term-line--cmd {
    color: var(--color-accent);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .prompt-prefix {
    color: var(--color-amber);
    margin-right: 0.4ch;
  }

  .hero__name {
    margin: 0 auto var(--space-4);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    font-weight: 700;
    color: var(--color-ink);
    max-width: min(18ch, 100%);
  }

  .hero__title {
    margin: 0 auto var(--space-4);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-accent);
    width: 100%;
    max-width: min(40ch, 100%);
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .hero__title {
      width: max-content;
    }
  }

  .hero__value {
    margin: 0 auto var(--space-4);
    font-size: var(--text-base);
    color: var(--color-ink);
    max-width: 40ch;
  }

  .hero__summary {
    margin: 0 auto var(--space-5);
    color: var(--color-ink-muted);
    max-width: 46ch;
  }

  .hero__cwd {
    margin: var(--space-5) 0 0;
    display: grid;
    gap: var(--space-1);
    justify-items: center;
    font-size: var(--text-sm);
    width: 100%;
  }

  .path {
    color: var(--color-ink-muted);
    margin: 0;
  }

  .boot-cursor {
    display: none;
    width: 0.55ch;
    height: 1.05em;
    background: var(--color-accent);
    animation: blink 1.1s step-end infinite;
    vertical-align: text-bottom;
  }

  /* While booting: hide upcoming lines; keep layout stable for typed ones */
  .hero__copy[data-booting] > [data-boot-item]:not([data-boot-active]):not([data-boot-done]) {
    visibility: hidden;
    height: 0;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__copy[data-booting] > [data-boot-item][data-boot-active],
  .hero__copy[data-booting] > [data-boot-item][data-boot-done] {
    visibility: visible;
    height: auto;
  }

  .hero__copy[data-booting] .boot-cursor {
    display: inline-block;
  }

  @media (min-width: 860px) {
    .hero__portrait-frame {
      width: 14rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-cursor {
      display: none !important;
    }

    .hero__copy[data-booting] > [data-boot-item] {
      visibility: visible !important;
      height: auto !important;
      margin: revert;
      overflow: visible;
      pointer-events: auto;
    }
  }
</style>

<script>
  function sleep(ms: number) {
    return new Promise<void>((resolve) => setTimeout(resolve, ms));
  }

  async function typeInto(
    target: HTMLElement,
    text: string,
    cursor: HTMLElement | null,
    charMs: number,
  ) {
    target.textContent = '';
    if (cursor) {
      target.appendChild(cursor);
    }
    for (let i = 0; i < text.length; i += 1) {
      const ch = text[i] ?? '';
      if (cursor) {
        target.insertBefore(document.createTextNode(ch), cursor);
      } else {
        target.textContent = (target.textContent ?? '') + ch;
      }
      await sleep(charMs);
    }
  }

  function revealPostBoot() {
    document.documentElement.setAttribute('data-boot-ready', '');
  }

  async function waitForImage(img: HTMLImageElement) {
    if (img.complete && img.naturalWidth > 0) {
      try {
        await img.decode();
      } catch {
        /* already decoded or decode unsupported */
      }
      return;
    }
    await new Promise<void>((resolve) => {
      img.addEventListener('load', () => resolve(), { once: true });
      img.addEventListener('error', () => resolve(), { once: true });
    });
    try {
      await img.decode();
    } catch {
      /* ignore */
    }
  }

  function sourceCoverRect(img: HTMLImageElement, destW: number, destH: number) {
    const iw = img.naturalWidth;
    const ih = img.naturalHeight;
    const scale = Math.max(destW / iw, destH / ih);
    const sw = destW / scale;
    const sh = destH / scale;
    const sx = (iw - sw) / 2;
    // Match object-position: center top
    const sy = 0;
    return { sx, sy, sw, sh };
  }

  function drawResolvedFrame(
    ctx: CanvasRenderingContext2D,
    img: HTMLImageElement,
    destW: number,
    destH: number,
    sampleW: number,
  ) {
    const { sx, sy, sw, sh } = sourceCoverRect(img, destW, destH);
    ctx.clearRect(0, 0, destW, destH);

    if (sampleW <= 0) {
      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, destW, destH);
      return;
    }

    const sampleH = Math.max(1, Math.round(sampleW * (destH / destW)));
    const tmp = document.createElement('canvas');
    tmp.width = sampleW;
    tmp.height = sampleH;
    const tctx = tmp.getContext('2d');
    if (!tctx) return;
    tctx.drawImage(img, sx, sy, sw, sh, 0, 0, sampleW, sampleH);
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(tmp, 0, 0, sampleW, sampleH, 0, 0, destW, destH);
  }

  async function resolvePortrait(media: HTMLElement) {
    const img = media.querySelector<HTMLImageElement>('[data-portrait]');
    const canvas = media.querySelector<HTMLCanvasElement>('.hero__portrait-canvas');
    const frame = media.querySelector<HTMLElement>('.hero__portrait-frame');
    if (!img || !canvas || !frame) {
      media.setAttribute('data-boot-done', '');
      return;
    }

    await waitForImage(img);

    const rect = frame.getBoundingClientRect();
    const cssW = Math.max(1, Math.round(rect.width));
    const cssH = Math.max(1, Math.round(rect.height));
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const destW = Math.round(cssW * dpr);
    const destH = Math.round(cssH * dpr);
    canvas.width = destW;
    canvas.height = destH;

    const ctx = canvas.getContext('2d');
    if (!ctx) {
      media.setAttribute('data-boot-done', '');
      return;
    }

    media.setAttribute('data-resolving', '');
    // Sample widths in CSS pixels — climb from chunky to sharp
    const steps = [8, 12, 18, 28, 44, 72, 110, 0];
    for (const sampleCss of steps) {
      const sampleW = sampleCss <= 0 ? 0 : Math.max(1, Math.round(sampleCss * dpr));
      drawResolvedFrame(ctx, img, destW, destH, sampleW);
      await sleep(sampleCss === 0 ? 60 : 110);
    }

    media.removeAttribute('data-resolving');
    media.setAttribute('data-boot-done', '');
  }

  async function boot(root: HTMLElement) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = [...root.querySelectorAll<HTMLElement>(':scope > [data-boot-item]')];
    const cursor = root.querySelector<HTMLElement>('[data-boot-cursor]');
    const media = document.querySelector<HTMLElement>('.hero__media[data-boot-item]');

    if (reduced) {
      root.removeAttribute('data-booting');
      root.removeAttribute('data-pending');
      media?.removeAttribute('data-resolving');
      media?.setAttribute('data-boot-done', '');
      items.forEach((item) => {
        item.setAttribute('data-boot-done', '');
        item.querySelectorAll<HTMLElement>('[data-text]').forEach((node) => {
          const inner = node.querySelector<HTMLElement>('.term-typed');
          if (inner && node.dataset.text) inner.textContent = node.dataset.text;
        });
        const typed = item.querySelector<HTMLElement>(':scope > .term-typed');
        if (typed && item.dataset.text) typed.textContent = item.dataset.text;
      });
      cursor?.remove();
      revealPostBoot();
      return;
    }

    if (media) {
      await resolvePortrait(media);
      await sleep(120);
    }

    root.removeAttribute('data-pending');
    root.setAttribute('data-booting', '');
    items.forEach((item) => {
      item.removeAttribute('data-boot-done');
      item.removeAttribute('data-boot-active');
      const mode = item.dataset.bootMode || 'output';
      // Only commands are typed; outputs keep (or restore) their full text
      if (mode === 'command') {
        item.querySelectorAll<HTMLElement>('.term-typed').forEach((node) => {
          node.textContent = '';
        });
      } else if (mode === 'command-block') {
        const cmdTyped = item.querySelector<HTMLElement>('.term-line--cmd .term-typed');
        if (cmdTyped) cmdTyped.textContent = '';
        const outLine = item.querySelector<HTMLElement>('.path');
        const outTyped = outLine?.querySelector<HTMLElement>('.term-typed');
        if (outTyped && outLine?.dataset.text) outTyped.textContent = outLine.dataset.text;
      } else if (mode === 'output') {
        const typed = item.querySelector<HTMLElement>('.term-typed');
        if (typed && item.dataset.text) typed.textContent = item.dataset.text;
      }
    });

    for (const item of items) {
      item.setAttribute('data-boot-active', '');
      const mode = item.dataset.bootMode || 'output';

      if (mode === 'fade') {
        item.style.opacity = '0';
        item.style.transition = 'opacity 280ms ease';
        requestAnimationFrame(() => {
          item.style.opacity = '1';
        });
        await sleep(320);
      } else if (mode === 'command-block') {
        const cmdLine = item.querySelector<HTMLElement>('.term-line--cmd');
        const outLine = item.querySelector<HTMLElement>('.path');
        const cmdTyped = cmdLine?.querySelector<HTMLElement>('.term-typed');
        const outTyped = outLine?.querySelector<HTMLElement>('.term-typed');
        const cmdText = cmdLine?.dataset.text ?? 'pwd';
        const outText = outLine?.dataset.text ?? '';

        if (cmdTyped && cursor) {
          await typeInto(cmdTyped, cmdText, cursor, 45);
        }
        await sleep(160);
        if (outTyped) {
          outTyped.textContent = outText;
          if (cursor) outTyped.appendChild(cursor);
        }
        await sleep(120);
      } else if (mode === 'command') {
        const typed = item.querySelector<HTMLElement>('.term-typed');
        const text = item.dataset.text ?? '';
        if (typed) {
          await typeInto(typed, text, cursor, 48);
        }
        await sleep(220);
      } else {
        // Output lines: reveal instantly (light fade)
        const typed = item.querySelector<HTMLElement>('.term-typed');
        if (typed && item.dataset.text) typed.textContent = item.dataset.text;
        item.style.opacity = '0';
        item.style.transition = 'opacity 180ms ease';
        requestAnimationFrame(() => {
          item.style.opacity = '1';
        });
        await sleep(200);
      }

      item.removeAttribute('data-boot-active');
      item.setAttribute('data-boot-done', '');
      item.style.opacity = '';
      item.style.transition = '';
    }

    // Park cursor after the final path output
    const lastTyped = root.querySelector<HTMLElement>(
      '.hero__cwd .path .term-typed, [data-boot-mode="command"][data-boot-done]:last-of-type .term-typed',
    );
    if (cursor && lastTyped) {
      lastTyped.appendChild(cursor);
    }
    root.removeAttribute('data-booting');
    root.removeAttribute('data-pending');
    revealPostBoot();
  }

  const root = document.querySelector<HTMLElement>('[data-terminal-boot]');
  if (root) {
    void boot(root);
  } else {
    revealPostBoot();
  }
</script>

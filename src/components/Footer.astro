---
interface Props {
  name: string;
  year: number;
  rights: string;
  builtWith: string;
}

const { name, year, rights, builtWith } = Astro.props;
---

<footer class="site-footer post-boot" data-post-boot>
  <div class="container site-footer__inner">
    <p class="prompt" style="margin:0">exit 0</p>
    <p>© {year} {name}. {rights}</p>
    <p>{builtWith} · dark-only terminal UI</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    text-align: center;
    color: var(--color-ink-subtle);
    font-size: var(--text-sm);
  }

  p {
    margin: 0;
  }
</style>

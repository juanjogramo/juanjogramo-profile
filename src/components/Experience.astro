---
import type { Profile } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';
import { formatPeriod } from '@/lib/i18n';

interface Props {
  profile: Profile;
  ui: UiCopy;
}

const { profile, ui } = Astro.props;
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <p class="prompt">ls {ui.experience.eyebrow.toLowerCase()}/</p>
    <h2 id="experience-title" class="section-title">{ui.experience.title}</h2>

    <ol class="timeline">
      {
        profile.experience.map((job) => (
          <li class="timeline__item">
            <div class="timeline__meta">
              <time datetime={`${job.start}/${job.end}`}>
                {formatPeriod(job.start, job.end, job.current, ui.experience.present)}
              </time>
              {job.location && <span>{job.location}</span>}
            </div>
            <div class="timeline__body">
              <h3>{job.role}</h3>
              <p class="company">{job.company}</p>
              <p class="summary">{job.summary}</p>
              {job.highlights.length > 0 && (
                <>
                  <p class="list-label"># {ui.experience.highlights.toLowerCase()}</p>
                  <ul>
                    {job.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              )}
              {job.technologies.length > 0 && (
                <>
                  <p class="list-label"># {ui.experience.technologies.toLowerCase()}</p>
                  <ul class="tag-list">
                    {job.technologies.map((tech) => (
                      <li class="tag">{tech}</li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }

  .timeline__item {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    text-align: center;
  }

  .timeline__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
  }

  .timeline__body h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-xl);
    color: var(--color-ink);
  }

  .company {
    margin: 0 0 var(--space-3);
    font-weight: 700;
    color: var(--color-accent);
  }

  .summary {
    margin: 0 auto var(--space-4);
    color: var(--color-ink-muted);
    max-width: 58ch;
  }

  .list-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-amber);
  }

  .timeline__body ul:not(.tag-list) {
    margin: 0 auto var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--color-ink-muted);
    max-width: 58ch;
    text-align: left;
  }

  .timeline__body ul:not(.tag-list) li {
    margin-bottom: var(--space-2);
  }

  .timeline__body ul:not(.tag-list) li::before {
    content: '> ';
    color: var(--color-accent);
  }

  @media (min-width: 800px) {
    .timeline__item {
      grid-template-columns: 10rem minmax(0, 1fr);
      text-align: left;
      gap: var(--space-5);
    }

    .timeline__meta {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-2);
      padding-top: 0.2rem;
    }

    .summary {
      margin-left: 0;
      margin-right: 0;
    }

    .tag-list {
      justify-content: flex-start;
    }

    .timeline__body ul:not(.tag-list) {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>

---
import type { Locale } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';
import { alternateLocale, localePath } from '@/lib/i18n';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  locale: Locale;
  ui: UiCopy;
  items: NavItem[];
}

const { locale, ui, items } = Astro.props;
const other = alternateLocale(locale);
const otherHref = locale === 'en' ? '/es' : '/';
const home = localePath(locale);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={home}>Juan José Granados</a>

    <nav class="nav-desktop" aria-label={ui.nav.primaryNav}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="theme-switch" data-theme-switch>
        <label class="visually-hidden" for="theme-select">{ui.theme.label}</label>
        <select id="theme-select" data-theme-select>
          <option value="system">{ui.theme.system}</option>
          <option value="light">{ui.theme.light}</option>
          <option value="dark">{ui.theme.dark}</option>
        </select>
      </div>

      <a class="lang-link" href={otherHref} hreflang={other} lang={other}>
        {other.toUpperCase()}
        <span class="visually-hidden">{ui.footer.language}: {other}</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span data-menu-label-open>{ui.nav.openMenu}</span>
        <span class="hidden" data-menu-label-close>{ui.nav.closeMenu}</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" hidden data-mobile-nav aria-label={ui.nav.primaryNav}>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} data-mobile-link>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-desktop ul {
    display: none;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-desktop a {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  .nav-desktop a:hover {
    color: var(--color-accent);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .theme-switch select,
  .lang-link,
  .menu-toggle {
    min-height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .theme-switch select {
    padding: 0.35rem 0.55rem;
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    padding: 0 0.7rem;
    text-decoration: none;
  }

  .menu-toggle {
    padding: 0 0.75rem;
    cursor: pointer;
  }

  .nav-mobile {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .nav-mobile ul {
    margin: 0;
    padding: var(--space-3) var(--space-4) var(--space-5);
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .nav-mobile a {
    display: block;
    padding: var(--space-3);
    text-decoration: none;
    border-radius: var(--radius-md);
    font-weight: 600;
  }

  .nav-mobile a:hover {
    background: var(--color-accent-soft);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hidden {
    display: none;
  }

  @media (min-width: 900px) {
    .nav-desktop ul {
      display: flex;
    }

    .menu-toggle,
    .nav-mobile {
      display: none !important;
    }
  }
</style>

<script>
  type ThemePreference = 'system' | 'light' | 'dark';

  const root = document.documentElement;
  const select = document.querySelector('[data-theme-select]');
  const stored = (localStorage.getItem('theme-preference') || 'system') as ThemePreference;

  function resolveTheme(preference: ThemePreference): 'light' | 'dark' {
    if (preference === 'system') {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    return preference;
  }

  function applyTheme(preference: ThemePreference) {
    root.dataset.theme = resolveTheme(preference);
    if (select instanceof HTMLSelectElement) {
      select.value = preference;
    }
  }

  applyTheme(stored);

  select?.addEventListener('change', (event) => {
    const value =
      event.target instanceof HTMLSelectElement
        ? (event.target.value as ThemePreference)
        : 'system';
    localStorage.setItem('theme-preference', value);
    applyTheme(value);
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    const preference = (localStorage.getItem('theme-preference') || 'system') as ThemePreference;
    if (preference === 'system') applyTheme('system');
  });

  const toggle = document.querySelector('[data-menu-toggle]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  const openLabel = document.querySelector('[data-menu-label-open]');
  const closeLabel = document.querySelector('[data-menu-label-close]');

  function setMenu(open: boolean) {
    if (!(toggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
    toggle.setAttribute('aria-expanded', String(open));
    mobileNav.hidden = !open;
    openLabel?.classList.toggle('hidden', open);
    closeLabel?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setMenu(open);
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>

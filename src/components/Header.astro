---
import type { Locale } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';
import { alternateLocale, localePath } from '@/lib/i18n';

interface NavItem {
  href: string;
  label: string;
  command: string;
}

interface Props {
  locale: Locale;
  ui: UiCopy;
  items: NavItem[];
  windowTitle: string;
}

const { locale, ui, items, windowTitle } = Astro.props;
const other = alternateLocale(locale);
const otherHref = locale === 'en' ? '/es' : '/';
const home = localePath(locale);
---

<header class="site-header">
  <div class="terminal-titlebar container-bar">
    <div class="terminal-titlebar__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <p class="terminal-titlebar__title">{windowTitle}</p>
    <div class="terminal-titlebar__actions">
      <a class="lang-link" href={otherHref} hreflang={other} lang={other}>
        ./{other}
        <span class="visually-hidden">{ui.footer.language}: {other}</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span data-menu-label-open>{ui.nav.openMenu}</span>
        <span class="hidden" data-menu-label-close>{ui.nav.closeMenu}</span>
      </button>
    </div>
  </div>

  <div class="nav-wrap">
    <a class="brand" href={home}>~/juanjogramo</a>
    <nav class="nav-desktop" aria-label={ui.nav.primaryNav}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href}>
                <span class="cmd">{item.command}</span>
                <span class="visually-hidden">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <nav id="mobile-nav" class="nav-mobile" hidden data-mobile-nav aria-label={ui.nav.primaryNav}>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} data-mobile-link>
              <span class="cmd">{item.command}</span>
              <span class="label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .container-bar,
  .nav-wrap {
    width: min(100% - 1.25rem, var(--content-max));
    margin-inline: auto;
  }

  .terminal-titlebar {
    border: 0;
    border-bottom: 1px solid var(--color-border);
    background: transparent;
    padding-inline: 0;
  }

  .terminal-titlebar__title {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .terminal-titlebar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .lang-link,
  .menu-toggle {
    min-height: 2rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-muted);
    color: var(--color-accent);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0 0.55rem;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .brand {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-desktop ul {
    display: none;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-desktop a {
    text-decoration: none;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .nav-desktop a:hover,
  .nav-desktop a:focus-visible {
    color: var(--color-accent);
  }

  .cmd::before {
    content: './';
    color: var(--color-ink-subtle);
  }

  .nav-mobile {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .nav-mobile ul {
    margin: 0;
    padding: var(--space-3) 0 var(--space-4);
    width: min(100% - 1.25rem, var(--content-max));
    margin-inline: auto;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .nav-mobile a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-ink);
  }

  .nav-mobile .label {
    color: var(--color-ink-subtle);
    font-size: var(--text-xs);
  }

  .hidden {
    display: none;
  }

  @media (min-width: 900px) {
    .nav-desktop ul {
      display: flex;
    }

    .menu-toggle,
    .nav-mobile {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  const openLabel = document.querySelector('[data-menu-label-open]');
  const closeLabel = document.querySelector('[data-menu-label-close]');

  function setMenu(open: boolean) {
    if (!(toggle instanceof HTMLButtonElement) || !(mobileNav instanceof HTMLElement)) return;
    toggle.setAttribute('aria-expanded', String(open));
    mobileNav.hidden = !open;
    openLabel?.classList.toggle('hidden', open);
    closeLabel?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setMenu(open);
  });

  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>

---
import '@/styles/global.css';
import type { Locale } from '@/content/schema';
import type { Profile } from '@/content/schema';
import type { UiCopy } from '@/content/i18n/ui';
import { siteConfig } from '@/content/site';
import { htmlLang, alternateLocale } from '@/lib/i18n';
import { personJsonLd, websiteJsonLd } from '@/lib/seo';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  locale: Locale;
  profile: Profile;
  ui: UiCopy;
  title?: string;
  description?: string;
}

const { locale, profile, ui, title, description } = Astro.props;
const pageTitle = title
  ? ui.meta.titleTemplate.replace('%s', title)
  : `${profile.fullName} · ${profile.professionalTitle}`;
const pageDescription = description ?? ui.meta.description;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteConfig.url).toString();
const other = alternateLocale(locale);
const otherPath = locale === 'en' ? '/es' : '/';
const ogImage = new URL(siteConfig.socialImage, siteConfig.url).toString();
const year = new Date().getFullYear();
const windowTitle = locale === 'es' ? 'juanjogramo@pe: ~ — zsh' : 'juanjogramo@pe: ~ — zsh';

const navItems = [
  { href: '#about', label: ui.nav.about, command: 'about' },
  { href: '#experience', label: ui.nav.experience, command: 'experience' },
  { href: '#expertise', label: ui.nav.expertise, command: 'expertise' },
  ...(profile.features.caseStudies ? [{ href: '#work', label: ui.nav.work, command: 'work' }] : []),
  ...(profile.features.projects
    ? [{ href: '#projects', label: ui.nav.projects, command: 'projects' }]
    : []),
  ...(profile.features.writing
    ? [{ href: '#writing', label: ui.nav.writing, command: 'writing' }]
    : []),
  { href: '#education', label: ui.nav.education, command: 'education' },
  { href: '#contact', label: ui.nav.contact, command: 'contact' },
];

const personLd = personJsonLd(profile);
const websiteLd = websiteJsonLd(pageDescription);
---

<!doctype html>
<html lang={htmlLang(locale)} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.fullName} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang(locale)} href={canonical} />
    <link
      rel="alternate"
      hreflang={htmlLang(other)}
      href={new URL(otherPath, siteConfig.url).toString()}
    />
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteConfig.url).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ui.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={htmlLang(locale).replace('-', '_')} />
    <meta property="og:locale:alternate" content={htmlLang(other).replace('-', '_')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ui.meta.ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#070a08" />

    <link
      rel="preload"
      href="/fonts/TypoPRO-LatinModernMono-Regular.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/TypoPRO-LatinModernSans-Bold.woff"
      as="font"
      type="font/woff"
      crossorigin
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </head>
  <body>
    <div class="scanlines" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <div class="terminal-shell">
      <Header locale={locale} ui={ui} items={navItems} windowTitle={windowTitle} />
      <main id="main">
        <slot />
      </main>
      <Footer
        name={profile.fullName}
        year={year}
        rights={ui.footer.rights}
        builtWith={ui.footer.builtWith}
      />
    </div>
  </body>
</html>
